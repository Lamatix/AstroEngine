# --- App ---
ENVIRONMENT=development
DEBUG=true

# --- Security / JWT ---
JWT_SECRET_KEY=<REPLACE_WITH_RANDOM_64_CHAR_SECRET>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database (used directly by docker-compose "db" service) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<REPLACE_WITH_DB_PASSWORD>
POSTGRES_DB=ai_service_platform
DATABASE_URL=postgresql+asyncpg://postgres:<REPLACE_WITH_DB_PASSWORD>@localhost:5432/ai_service_platform

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000"]

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- LLM Providers ---
OPENAI_API_KEY=<REPLACE_WITH_OPENAI_API_KEY>
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=<REPLACE_WITH_GEMINI_API_KEY>
GEMINI_MODEL=gemini-1.5-pro
LLM_REQUEST_TIMEOUT_SECONDS=30

# --- Credit Economy ---
SIGNUP_BONUS_CREDITS=50
CREDIT_COST_LLM_REQUEST=5
CREDIT_COST_VIDEO_SHORT=40
CREDIT_COST_VIDEO_MAIN=100

# --- Stripe ---
STRIPE_SECRET_KEY=<REPLACE_WITH_STRIPE_SECRET_KEY>
STRIPE_WEBHOOK_SECRET=<REPLACE_WITH_STRIPE_WEBHOOK_SECRET>
STRIPE_PUBLISHABLE_KEY=<REPLACE_WITH_STRIPE_PUBLISHABLE_KEY>

# --- Video Engine ---
VIDEO_STORAGE_PATH=./storage/videos
VIDEO_RENDERER_BACKEND=mock

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# --- xAI / Grok ---
XAI_API_KEY=REPLACE_WITH_XAI_KEY
XAI_MODEL=grok-beta

# --- n8n Entegrasyonu ---
N8N_WEBHOOK_URL=http://n8n:5678/webhook/astroengine
N8N_API_KEY=REPLACE_WITH_N8N_API_KEY

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
